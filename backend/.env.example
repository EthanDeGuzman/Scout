NODE_ENV=development
PORT=3001
# Use the POSTGRES_USER / POSTGRES_PASSWORD from the root .env
DATABASE_URL=postgres://scout:<password>@localhost:5432/scout

# Generate each with: openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# demo = auto-login as the seeded demo user, no Microsoft needed
# microsoft = real Outlook login
AUTH_MODE=demo

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=60000
CLASSIFICATION_REVIEW_THRESHOLD=0.7

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_AUTHORITY=https://login.microsoftonline.com/consumers
MS_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
FRONTEND_URL=http://localhost:5173

SYNC_LOOKBACK_DAYS=30
# 0 = manual sync only
SYNC_INTERVAL_MINUTES=0
